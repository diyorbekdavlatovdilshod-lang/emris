# Local development settings for the Telegram Business assistant bot.
#
# Setup:
#   cp .env.example .env && chmod 600 .env
#
# On Railway this file is NOT used. Set variables of the same names in
# Service -> Variables instead.
#
# IMPORTANT: comments go on their own line, never after a value on the same
# line. python-dotenv would read "KEY=value   # comment" with the comment
# included.

# --- Telegram (required to run the bot; not needed for --check-claude/--try)

# Bot token from @BotFather, shaped like 123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=

# Your own Telegram user id (a number). Get it from @userinfobot.
OWNER_ID=

# --- Behaviour

# false = PREVIEW (drafts are only logged, nothing is sent). Start here.
# true  = AUTO-SEND (replies are sent automatically).
AUTO_SEND=false

# --- Claude access

# Subscription token from `claude setup-token` (starts with sk-ant-oat...).
# Generate it ONCE on a machine with a browser; it is valid for ~1 year.
# Treat it like a password. Paste it with an editor as a SINGLE line
# (do NOT use `echo ... >> .env`, which puts it in your shell history).
# If left empty, this machine's own `claude` login is used (local testing).
CLAUDE_CODE_OAUTH_TOKEN=

# --- Optional Claude tuning (leave blank for defaults)

# Path to the claude binary. Blank = auto-detect (PATH, then ~/.local/bin).
CLAUDE_BIN=

# Model id. Blank = the CLI default.
CLAUDE_MODEL=

# Reasoning effort: low, medium, high, xhigh, max. Default low.
CLAUDE_EFFORT=low

# Seconds to wait for one reply. Default 120, minimum 1.
CLAUDE_TIMEOUT_SECONDS=

# Minutes to back off after a usage limit when no reset time is known.
# Default 30, minimum 1.
LIMIT_COOLDOWN_MINUTES=

# Minutes the bot stays silent in a chat after YOU reply there yourself.
# Default 15, minimum 0 (0 disables takeover).
OWNER_TAKEOVER_MINUTES=

# How many messages per chat to keep as context. Default 30, minimum 1.
HISTORY_LIMIT=
